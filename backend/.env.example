# Database (NeonDB PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Auth (JWT)
JWT_SECRET=change-this-to-a-random-64-char-hex-string-in-production
CSRF_SECRET=change-this-to-a-random-64-char-hex-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Admin Seed Credentials (first-run only)
ADMIN_EMAIL=sales@alkatraders.co
ADMIN_PASSWORD=admin123

# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# PayPal Payments
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=sales@alkatraders.co
RFQ_EMAIL=sales@alkatraders.co
EMERGENCY_EMAIL=sales@alkatraders.co

# Store Defaults
WHATSAPP_NUMBER=918799095041
COMPANY_PHONE=+9714XXXXXXX
COMPANY_EMAIL=sales@alkatraders.co
COMPANY_NAME=Alka Traders
DEFAULT_SHIPPING_COST=25
DEFAULT_TAX_RATE=0.08
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=AE

# Image Hosting (Cloudinary)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=

# Playwright E2E Testing (set to any value to bypass rate limits during tests)
PLAYWRIGHT_TEST=
