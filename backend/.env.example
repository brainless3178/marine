[TEMPLATE]
# Database (NeonDB)
DATABASE_URL=postgresql://neondb_owner:password@ep-xxx-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://neondb_owner:password@ep-xxx-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=change-this-to-a-random-64-char-hex-string-in-production
CSRF_SECRET=change-this-to-a-random-64-char-hex-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
ADMIN_EMAIL=admin@alkatraders.com
ADMIN_PASSWORD=admin123

# Server
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
ADMIN_URL=http://localhost:5173/admin

# Payments (PayPal)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM=noreply@alkatraders.com
RFQ_EMAIL=rfq@alkatraders.com
EMERGENCY_EMAIL=emergency@alkatraders.com

# Store Defaults
DEFAULT_CURRENCY=USD
DEFAULT_COUNTRY=AE
WHATSAPP_NUMBER=919726900547
COMPANY_PHONE=+9714XXXXXXX
COMPANY_EMAIL=info@alkatraders.com
COMPANY_NAME=Alka Traders
DEFAULT_SHIPPING_COST=25
DEFAULT_TAX_RATE=0.08

# Logging
LOG_LEVEL=info
SENTRY_DSN=
