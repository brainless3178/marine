{
  "name": "alka-traders",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build:backend": "cd backend && npm install --include=dev && npx prisma generate && npx tsc",
    "build": "npm run build:backend && node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build && node scripts/copy-frontend.mjs && (node scripts/prerender.mjs || true) && (node scripts/generate-sitemap.mjs || true)",
    "build:hostinger": "npm run build",
    "start": "node server.js",
    "postinstall": "cd backend && npx prisma generate",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b --noEmit",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "deploy:netlify": "npx -y netlify-cli deploy --prod --dir=dist --site 2bf187c6-9d37-462f-a61d-83af462c2e73",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.1.2",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/node": "^10.65.0",
    "@sentry/react": "^10.65.0",
    "@tanstack/react-query": "^5.101.4",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^12.40.0",
    "helmet": "^8.1.0",
    "i18next": "^26.3.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.17.0",
    "morgan": "^1.11.0",
    "multer": "^2.0.1",
    "papaparse": "^5.5.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.2",
    "resend": "^4.5.2",
    "sharp": "^0.35.3",
    "three": "^0.184.0",
    "uuid": "^11.1.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-precaching": "^7.4.1",
    "xss": "^1.0.15",
    "zod": "^3.25.67",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "brace-expansion": "5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.3",
    "@types/papaparse": "^5.5.2",
    "@types/pino": "^7.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.4",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.9",
    "prisma": "^5.22.0",
    "typescript": "~5.8.3"
  }
